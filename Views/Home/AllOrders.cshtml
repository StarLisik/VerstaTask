@model List<OrderModel>

<style>
    .OrdersTable {
        border-collapse: collapse;
        width: 100%;
        border: 3px solid black;
    }

    .OrdersTable td {
        border: 1px solid black;
        padding: 8px;
    }

    .FirstRow {
        border: 3px solid black;
    }

    .TableRows {
        border: 2px solid black;
    }
</style>

<h2>Заказы</h2>
<table class="OrdersTable">
    <tr class="FirstRow">
        <td><b>Номер заказа</b></td>
        <td><b>Город отправителя</b></td>
        <td><b>Адрес отправителя</b></td>
        <td><b>Город получателя</b></td>
        <td><b>Адрес получателя</b></td>
        <td><b>Вес</b></td>
        <td><b>Дата забора груза</b></td>
    </tr>
    @foreach(var order in Model)
    {
        <tr class="TableRows" onclick="location.href='@Url.Action("GetOrderById", "Home", new { id = order.Id })'">
            <td>@order.Id</td>
            <td>@order.CitySender</td>
            <td>@order.AdressSender</td>
            <td>@order.CityReceiver</td>
            <td>@order.AdressReceiver</td>
            <td>@order.Weight</td>
            <td>@order.PickDate</td>
        </tr>
    }
</table>
